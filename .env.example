# ============================================================================
# HR Attrition Rate - Environment Variables (Production Ready)
# ============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_DB=hr_attrition_db
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme_secure_password_here
DATABASE_URL=postgresql://user:changeme_secure_password_here@db:5432/hr_attrition_db

# ============================================================================
# API CONFIGURATION
# ============================================================================
# API authentication key (REQUIRED for /predict endpoint)
# Generate: openssl rand -hex 32
API_KEY=changeme_secure_api_key_here

# JWT Secret Key (min 32 characters)
# Generate: openssl rand -hex 32
SECRET_KEY=changeme_secure_secret_key_min_32_chars_here

# API server settings
API_HOST=0.0.0.0
API_PORT=8001

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================
WORKER_POLL_SEC=2
WORKER_STALE_SEC=600

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
DISABLE_DB=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
MODEL_PATH=outputs/employee_attrition_pipeline.pkl
MODEL_VERSION=1.0.0

# ============================================================================
# STREAMLIT UI CONFIGURATION
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
API_BASE_URL=http://fastapi_app:8001

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Enable CORS (comma-separated origins)
# CORS_ORIGINS=http://localhost:8501,https://yourdomain.com

# Rate limiting (requests per minute)
# RATE_LIMIT=60

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# For Docker Compose: Copy to .env in project root
# For Kubernetes: Create ConfigMap/Secret from these values
# For Cloud (AWS/GCP/Azure): Set in environment variables
# 
# SECURITY CHECKLIST:
# ✓ Change all passwords and keys
# ✓ Use strong random values (min 32 characters)
# ✓ Never commit .env to git
# ✓ Rotate keys regularly
# ✓ Use secret management service in production (AWS Secrets Manager, etc.)

