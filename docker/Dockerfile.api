# Dockerfile for FastAPI Backend (Production)
# Multi-stage build for smaller, more secure images

# Stage 1: Builder
FROM python:3.13-slim AS builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Configure Poetry
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install dependencies (no dev)
RUN poetry install --no-root --without dev,ui && rm -rf $POETRY_CACHE_DIR

# Stage 2: Runtime
FROM python:3.13-slim

# Metadata
LABEL maintainer="HR Attrition Team"
LABEL version="1.0.0"
LABEL description="FastAPI HR Attrition Prediction Service"

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user before copying files so --chown works
RUN groupadd -r appuser && useradd -r -g appuser -u 1000 appuser

# Create necessary directories with correct ownership
RUN mkdir -p /app/temp /app/shap_images && chown appuser:appuser /app/temp /app/shap_images

# Copy virtual environment and application code with correct ownership at copy time
COPY --chown=appuser:appuser --from=builder /app/.venv /app/.venv
COPY --chown=appuser:appuser api ./api
COPY --chown=appuser:appuser core ./core
COPY --chown=appuser:appuser database ./database
COPY --chown=appuser:appuser models ./models
COPY --chown=appuser:appuser scripts ./scripts

# Switch to non-root user
USER appuser

# Set PATH to use virtual environment
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run the API server
CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "4"]
