# Multi-stage build for lean Hugging Face deployment
FROM python:3.13-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Configure Poetry
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install dependencies (no dev, no root)
RUN poetry install --no-root --without dev && rm -rf $POETRY_CACHE_DIR

# Runtime stage
FROM python:3.13-slim

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Copy Poetry and virtualenv from builder
COPY --from=builder /root/.local /root/.local
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/root/.local/bin:/app/.venv/bin:$PATH"

# Copy application code
COPY api/ ./api/
COPY core/ ./core/
COPY database/ ./database/
COPY outputs/ ./outputs/
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY ui/ ./ui/
COPY .streamlit/ ./.streamlit/
COPY pyproject.toml poetry.lock ./

# Create necessary directories
RUN mkdir -p /app/temp /app/shap_images /app/db_data /var/log/supervisor

# Create lean supervisor configuration
RUN echo '[supervisord]\n\
nodaemon=true\n\
logfile=/dev/stdout\n\
logfile_maxbytes=0\n\
loglevel=info\n\
\n\
[program:fastapi]\n\
command=/app/.venv/bin/uvicorn api.app.main:app --host 0.0.0.0 --port 8001 --workers 2\n\
directory=/app\n\
autostart=true\n\
autorestart=true\n\
stdout_logfile=/dev/stdout\n\
stdout_logfile_maxbytes=0\n\
stderr_logfile=/dev/stderr\n\
stderr_logfile_maxbytes=0\n\
\n\
[program:streamlit]\n\
command=/app/.venv/bin/streamlit run ui/app_authenticated.py --server.port=7860 --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false\n\
directory=/app\n\
autostart=true\n\
autorestart=true\n\
stdout_logfile=/dev/stdout\n\
stdout_logfile_maxbytes=0\n\
stderr_logfile=/dev/stderr\n\
stderr_logfile_maxbytes=0\n\
environment=API_BASE_URL="http://localhost:8001"\n\
' > /etc/supervisor/conf.d/supervisord.conf

# Demo environment variables (simplified security for demo)
ENV DATABASE_URL=sqlite:///db_data/hr_attrition.db \
    DISABLE_DB=false \
    API_BASE_URL=http://localhost:8001 \
    API_KEY=demo_huggingface_api_key \
    SECRET_KEY=demo_secret_key_for_huggingface_deployment_min_32_chars \
    UI_ADMIN_USERNAME=admin \
    UI_ADMIN_PASSWORD=Admin@2025!Secure \
    UI_USER_USERNAME=analyst \
    UI_USER_PASSWORD=Analyst@2025!View

# Expose Hugging Face default port
EXPOSE 7860

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health', timeout=5)" || exit 1

# Initialize database and start services
CMD /app/.venv/bin/python -m database.init_db && supervisord -c /etc/supervisor/conf.d/supervisord.conf
