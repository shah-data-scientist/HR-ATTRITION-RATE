# Dockerfile for Database Initialization (Production)
FROM python:3.13-slim

# Metadata
LABEL maintainer="HR Attrition Team"
LABEL version="1.0.0"
LABEL description="Database Initialization Service"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Python dependencies directly
RUN pip install --no-cache-dir \
    "sqlalchemy>=2.0.44,<3.0.0" \
    "psycopg2-binary>=2.9.11,<3.0.0" \
    "pandas>=2.2.0,<3.0.0" \
    "python-dotenv>=1.2.1,<2.0.0" \
    "bcrypt>=4.0.0,<5.0.0"

# Copy database code, data, and scripts
COPY database/ ./database/
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY core/ ./core/

# Create non-root user and set permissions
RUN groupadd -r dbuser && useradd -r -g dbuser -u 1002 dbuser \
    && mkdir -p /app/db_data \
    && chown -R dbuser:dbuser /app

# Switch to non-root user
USER dbuser

# Environment variables
ENV DATABASE_URL=postgresql://user:password@db:5432/hr_attrition_db \
    DISABLE_DB=false \
    PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "from database.database import engine; engine.connect()" || exit 1

# Initialize database on startup
CMD ["python", "-m", "database.init_db"]
