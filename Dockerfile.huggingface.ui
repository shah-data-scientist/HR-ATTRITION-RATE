FROM python:3.13-slim

WORKDIR /app

# Install system dependencies including Poetry
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Configure Poetry
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Copy Poetry configuration files
COPY pyproject.toml poetry.lock ./

# Install dependencies using Poetry (no dev dependencies)
RUN poetry install --no-root --without dev && rm -rf $POETRY_CACHE_DIR

# Copy UI code only
COPY ui/app.py ./app.py
COPY .streamlit/ ./.streamlit/

# Expose Hugging Face default port
EXPOSE 7860

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:7860/_stcore/health || exit 1

# Run Streamlit on port 7860 using Poetry (Hugging Face requirement)
CMD ["poetry", "run", "streamlit", "run", "app.py", "--server.port=7860", "--server.address=0.0.0.0"]
